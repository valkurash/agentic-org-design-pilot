{
  "interfaces": [
    "POST /api/todos",
    "GET /api/todos",
    "DELETE /api/todos/{id}",
    "POST /api/reminders"
  ],
  "constraints": {
    "performance": "100 req/s",
    "latency": "p99 < 200ms"
  },
  "tech_stack": "Node.js + Express",
  "remarks": [
    "Log reminder events for notifications",
    "Utilize existing session middleware"
  ],
  "module_boundaries": {
    "todos": "TODO CRUD only — no reminder-specific fields on the Todo model",
    "reminders": "Separate Reminder entity/module for schedule + notify"
  },
  "data_model": {
    "Todo": {
      "id": "UUID",
      "title": "string",
      "description": "string",
      "completed": "boolean",
      "created_at": "datetime",
      "updated_at": "datetime"
    },
    "Reminder": {
      "id": "UUID",
      "todo_id": "UUID",
      "reminder_datetime": "datetime",
      "notified": "boolean"
    }
  }
}
