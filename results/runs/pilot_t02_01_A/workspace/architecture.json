{
  "state_machine": {
    "states": [
      "draft",
      "submitted",
      "approved",
      "rejected",
      "needs_finance"
    ],
    "transitions": {
      "draft": ["submitted"],
      "submitted": ["approved", "rejected", "needs_finance"],
      "needs_finance": ["approved", "rejected"],
      "approved": [],
      "rejected": []
    }
  },
  "roles": {
    "employee": {
      "can_transition": {
        "draft": ["submitted"]
      }
    },
    "manager": {
      "can_transition": {
        "submitted": ["approved", "rejected"],
        "needs_finance": ["approved", "rejected"]
      },
      "limit": 500
    },
    "finance": {
      "can_transition": {
        "needs_finance": ["approved","rejected"]
      },
      "limit": 5000
    }
  },
  "policy": "policy/approval_limits.json",
  "audit_trail": {
    "fields": [
      "actor_role",
      "from_status",
      "to_status",
      "timestamp",
      "comment"
    ]
  },
  "integrity": {
    "schema": "schemas/expense_claim.schema.json"
  }
}