{
  "state_machine": {
    "states": ["draft", "submitted", "needs_finance", "approved", "rejected"],
    "transitions": {
      "draft": ["submitted"],
      "submitted": ["approved", "rejected", "needs_finance"],
      "needs_finance": ["approved", "rejected"]
    }
  },
  "roles": {
    "employee": ["draft->submitted"],
    "manager": ["submitted->approved", "submitted->rejected", "submitted->needs_finance"],
    "finance": ["needs_finance->approved", "needs_finance->rejected"]
  },
  "policy_file": "policy/approval_limits.json",
  "audit_trail_fields": {
    "actor_role": "string",
    "from_status": "string",
    "to_status": "string",
    "ts": "timestamp"
  }
}