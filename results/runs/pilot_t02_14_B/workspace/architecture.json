{
  "state_machine": {
    "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
    "transitions": {
      "employee": [
        {"from": "draft", "to": "submitted"}
      ],
      "manager": [
        {"from": "submitted", "to": "approved", "conditions": {"amount": {"lte": "manager_limit_usd"}}},
        {"from": "submitted", "to": "rejected", "conditions": {"amount": {"lte": "manager_limit_usd"}}}
      ],
      "finance": [
        {"from": "needs_finance", "to": "approved"},
        {"from": "needs_finance", "to": "rejected"}
      ]
    }
  },
  "roles": [
    "employee", "manager", "finance"
  ],
  "policy_file": "policy/approval_limits.json",
  "audit_trail_fields": [
    "actor_role", "from_status", "to_status", "ts"
  ],
  "frozen_modules": [
    "policy/approval_limits.json"
  ]
}