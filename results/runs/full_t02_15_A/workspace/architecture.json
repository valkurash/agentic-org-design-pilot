{
  "state_machine": {
    "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
    "transitions": {
      "draft": ["submitted"],
      "submitted": ["approved", "rejected", "needs_finance"],
      "needs_finance": ["approved", "rejected"],
      "approved": [],
      "rejected": []
    }
  },
  "roles": {
    "employee": ["submit"],
    "manager": ["approve", "reject", "needs_finance"],
    "finance": ["approve", "reject"]
  },
  "policy": {
    "file_path": "policy/approval_limits.json"
  },
  "audit_trail": {
    "fields": ["actor_role", "from_status", "to_status", "ts"]
  }
}