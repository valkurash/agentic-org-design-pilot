{
    "state_machine": {
        "states": [
            "draft",
            "submitted",
            "needs_finance",
            "approved",
            "rejected"
        ],
        "transitions": {
            "submit": {"from": "draft", "to": "submitted"},
            "approve_manager": {"from": "submitted", "to": "approved", "condition": "amount <= policy/approval_limits.json.manager_limit_usd"},
            "escalate_to_finance": {"from": "submitted", "to": "needs_finance", "condition": "amount > policy/approval_limits.json.manager_limit_usd"},
            "approve_finance": {"from": "needs_finance", "to": "approved"},
            "reject": {"from": ["submitted", "needs_finance"], "to": "rejected"}
        }
    },
    "roles": {
        "submitter": ["submit"],
        "manager": ["approve_manager", "reject"],
        "finance": ["approve_finance", "reject"]
    },
    "audit_trail_fields": [
        "actor_role",
        "from_status",
        "to_status",
        "ts"
    ],
    "policy_reference": "policy/approval_limits.json"
}