{
  "state_machine": {
    "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
    "transitions": {
      "draft": ["submitted"],
      "submitted": ["approved", "rejected", "needs_finance"],
      "needs_finance": ["approved", "rejected"]
    }
  },
  "roles": {
    "Employee": {
      "can_transition": {
        "draft": ["submitted"]
      }
    },
    "Manager": {
      "can_transition": {
        "submitted": ["approved", "rejected", "needs_finance"]
      },
      "approval_limit": "policy/approval_limits.json#manager_limit_usd"
    },
    "Finance": {
      "can_transition": {
        "needs_finance": ["approved", "rejected"]
      }
    }
  },
  "audit_trail": {
    "fields": ["actor_role", "from_status", "to_status", "timestamp"]
  },
  "policy_reference": "policy/approval_limits.json",
  "validation_schema": "schemas/expense_claim.schema.json",
  "frozen_modules": ["policy/approval_limits.json"]
}