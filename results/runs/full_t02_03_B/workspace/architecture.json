{
  "state_machine": {
    "states": [
      "draft",
      "submitted",
      "needs_finance",
      "approved",
      "rejected"
    ],
    "transitions": {
      "employee": {
        "from": "draft",
        "to": "submitted"
      },
      "manager": {
        "from": "submitted",
        "to": [
          "approved",
          "rejected",
          "needs_finance"
        ],
        "condition": "amount <= policy.manager_limit_usd"
      },
      "finance": {
        "from": "needs_finance",
        "to": [
          "approved",
          "rejected"
        ]
      }
    }
  },
  "roles": {
    "employee": "Can create and submit claims.",
    "manager": "Can approve/reject claims within limit or escalate to finance if above limit.",
    "finance": "Can approve/reject escalated claims."
  },
  "policy_file_reference": "policy/approval_limits.json",
  "data_model": {
    "audit_trail": {
      "fields": [
        "actor_role",
        "from_status",
        "to_status",
        "ts"
      ]
    }
  },
  "interfaces": "Direct references are avoided; state machine and policy application guide interactions.",
  "module_boundaries": {
    "error_handling": "Include schema validation and error handling in separate utility modules where required.",
    "policy_reference": "Frozen policy file \u2013 no code extends beyond reading from it."
  },
  "frozen_modules": [
    "policy/approval_limits.json"
  ],
  "special_handling": "Ask guidance for category 'other'."
}