{
  "state_machine": {
    "states": ["draft", "submitted", "needs_finance", "approved", "rejected"],
    "transitions": {
      "employee": ["draft -> submitted"],
      "manager": ["submitted -> approved (<= manager_limit_usd)", "submitted -> rejected", "submitted -> needs_finance (> manager_limit_usd)"],
      "finance": ["needs_finance -> approved", "needs_finance -> rejected"]
    }
  },
  "roles": ["employee", "manager", "finance"],
  "policy_file": "policy/approval_limits.json",
  "audit_trail": {
    "fields": ["actor_role", "from_status", "to_status", "ts"]
  }
}