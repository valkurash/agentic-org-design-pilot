{
  "state_machine": {
    "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
    "transitions": [
      {"from": "draft", "to": "submitted", "role": "employee"},
      {"from": "submitted", "to": "approved", "role": "manager", "condition": "amount <= manager_limit_usd"},
      {"from": "submitted", "to": "rejected", "role": "manager"},
      {"from": "submitted", "to": "needs_finance", "role": "system", "condition": "amount > manager_limit_usd"},
      {"from": "needs_finance", "to": "approved", "role": "finance", "after_logging": true},
      {"from": "needs_finance", "to": "rejected", "role": "finance"}
    ]
  },
  "roles": ["employee", "manager", "finance"],
  "policy_reference": "policy/approval_limits.json",
  "audit_trail": {
    "fields": ["actor_role", "from_status", "to_status", "ts"]
  },
  "policy": {
    "manager_limit_usd": 500,
    "finance_limit_usd": 5000,
    "allowed_categories": ["travel", "meals", "equipment", "other"]
  }
}