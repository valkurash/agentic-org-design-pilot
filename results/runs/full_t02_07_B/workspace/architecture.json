{
  "state_machine": {
    "states": [
      "draft",
      "submitted",
      "approved",
      "rejected",
      "needs_finance"
    ],
    "transitions": {
      "draft": [
        "submitted"
      ],
      "submitted": [
        "approved",
        "rejected",
        "needs_finance"
      ],
      "needs_finance": [
        "approved",
        "rejected"
      ]
    }
  },
  "roles": {
    "employee": {
      "can_submit": true,
      "can_approve": false
    },
    "manager": {
      "can_approve_up_to": "manager_limit_usd"
    },
    "finance": {
      "can_approve": true
    }
  },
  "policy_file_path": "policy/approval_limits.json",
  "audit_trail": {
    "fields": [
      "actor_role",
      "from_status",
      "to_status",
      "ts"
    ]
  },
  "data_model": {
    "entities": [
      "claims",
      "audit_trail"
    ],
    "formats": [
      "json"
    ]
  },
  "frozen_modules": [
    "policy/approval_limits.json"
  ]
}