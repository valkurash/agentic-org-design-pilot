{
    "state_machine": {
        "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
        "transitions": {
            "draft": ["submitted"],
            "submitted": {
                "manager": ["approved", "rejected"],
                "finance": ["approved", "rejected"],
                "policy_check": ["needs_finance"]
            },
            "needs_finance": ["approved", "rejected"]
        }
    },
    "roles": {
        "employee": ["submit_claim"],
        "manager": ["approve_claim", "reject_claim"],
        "finance": ["approve_claim", "reject_claim"]
    },
    "policy_file_reference": "policy/approval_limits.json",
    "audit_trail_fields": ["actor_role", "from_status", "to_status", "ts"],
    "constraints": {
        "manager_limit_usd": 500,
        "finance_limit_usd": 5000,
        "allowed_categories": ["travel", "meals", "equipment", "other"]
    }
}