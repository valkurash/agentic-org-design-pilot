{
  "state_machine": {
    "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
    "transitions": {
      "draft": ["submitted"],
      "submitted": ["approved", "rejected", "needs_finance"],
      "needs_finance": ["approved", "rejected"],
      "rejected": [],
      "approved": []
    }
  },
  "roles": {
    "employee": ["draft", "submitted"],
    "manager": ["approved", "rejected", "needs_finance"],
    "finance": ["approved", "rejected"]
  },
  "policy_references": {
    "file": "policy/approval_limits.json",
    "manager_limit_usd": 500,
    "finance_limit_usd": 5000
  },
  "audit_trail_shape": {
    "fields": ["actor_role", "from_status", "to_status", "timestamp"],
    "requirement": "minimum one entry per status transition"
  },
  "frozen_modules": [
    {
      "path": "policy/approval_limits.json",
      "reason": "Integral to policy and decision thresholds"
    }
  ],
  "data_model": {
    "entities": {
      "expense_claim": {
        "schema": "schemas/expense_claim.schema.json",
        "properties": ["claim_id", "submitter_id", "amount_usd", "currency", "category", "status", "memo", "approver_role"]
      }
    }
  }
}