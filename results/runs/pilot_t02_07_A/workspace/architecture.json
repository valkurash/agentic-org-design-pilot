{
  "state_machine": {
    "states": [
      "draft",
      "submitted",
      "approved",
      "rejected",
      "needs_finance"
    ],
    "transitions": [
      {
        "role": "Employee",
        "from": "draft",
        "to": "submitted"
      },
      {
        "role": "Manager",
        "from": "submitted",
        "to": "approved",
        "condition": "amount <= policy/approval_limits.json.manager_limit_usd"
      },
      {
        "role": "Manager",
        "from": "submitted",
        "to": "rejected",
        "condition": "amount <= policy/approval_limits.json.manager_limit_usd"
      },
      {
        "role": "Manager",
        "from": "submitted",
        "to": "needs_finance",
        "condition": "amount > policy/approval_limits.json.manager_limit_usd"
      },
      {
        "role": "Finance",
        "from": "needs_finance",
        "to": "approved"
      },
      {
        "role": "Finance",
        "from": "needs_finance",
        "to": "rejected"
      }
    ]
  },
  "roles": [
    "Employee",
    "Manager",
    "Finance"
  ],
  "policy_file": "policy/approval_limits.json",
  "audit_trail_fields": [
    "actor_role",
    "from_status",
    "to_status",
    "ts"
  ]
}