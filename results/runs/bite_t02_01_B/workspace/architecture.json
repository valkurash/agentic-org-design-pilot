{
  "state_machine": {
    "states": ["draft", "submitted", "approved", "rejected", "needs_finance"],
    "transitions": {
      "Employee": {"draft": "submitted"},
      "Manager": {"submitted": ["approved", "rejected"]},
      "Finance": {"needs_finance": ["approved", "rejected"]}
    }
  },
  "roles": ["Employee", "Manager", "Finance"],
  "policy_file": "policy/approval_limits.json",
  "policy_integration": {
    "manager_limit_usd": "from policy",
    "finance_limit_usd": "from policy",
    "currency": "from policy"
  },
  "audit_trail_fields": ["actor_role", "from_status", "to_status", "ts"],
  "data_model": {
    "claim_fields": ["amount", "currency", "category", "memo"]
  },
  "frozen_modules": ["policy/approval_limits.json"]
}