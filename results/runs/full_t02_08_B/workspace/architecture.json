{
  "state_machine": {
    "states": [
      "Draft",
      "Submitted",
      "Approved",
      "Rejected",
      "Needs Finance"
    ],
    "transitions": {
      "Employee": {
        "Draft": [
          "Submitted"
        ]
      },
      "Manager": {
        "Submitted": {
          "approve": [
            "Approved"
          ],
          "reject": [
            "Rejected"
          ]
        }
      },
      "Finance": {
        "Needs Finance": {
          "approve": [
            "Approved"
          ],
          "reject": [
            "Rejected"
          ]
        }
      }
    }
  },
  "roles_and_transitions": {
    "Employee": [
      "create",
      "submit"
    ],
    "Manager": [
      "approve",
      "reject"
    ],
    "Finance": [
      "approve",
      "reject"
    ],
    "Escalation": [
      "clarification"
    ]
  },
  "policy_file_reference": "policy/approval_limits.json",
  "audit_trail_schema": {
    "fields": [
      "actor_role",
      "from_status",
      "to_status",
      "ts"
    ]
  },
  "frozen_modules": [
    "policy/approval_limits.json"
  ],
  "constraints": {
    "allowed_categories": [
      "travel",
      "meals",
      "equipment",
      "other"
    ],
    "handle_category_as_other": "escalation_required"
  }
}